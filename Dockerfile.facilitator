FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY runtime/facilitator/package.json runtime/facilitator/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force
COPY server/src/evm-facilitator.ts ./server/src/evm-facilitator.ts
COPY scripts/run-local-evm-facilitator.ts scripts/verify-facilitator-runtime.ts ./scripts/
COPY contracts/artifacts/Refuel402ExactPermit2Proxy.json ./contracts/artifacts/Refuel402ExactPermit2Proxy.json
RUN npm run runtime:verify
USER node
EXPOSE 4402
CMD ["npm", "start"]
