# Refuel402 — one-MetaMask source configuration
HEDERA_NETWORK=testnet
PORT=4020
# Hedera's public Mirror REST endpoints support both light readback and
# /api/v1/contracts/call simulation. Quote calls are serialized and rate-limited.
TESTNET_MIRROR_BASE_URL=https://testnet.mirrornode.hedera.com
MAINNET_MIRROR_BASE_URL=https://mainnet.mirrornode.hedera.com
# Optional HTTPS overrides for operators with another Mirror provider. Blank means
# use the matching public Mirror base above; credential-bearing URLs stay secret.
TESTNET_QUOTE_MIRROR_BASE_URL=
MAINNET_QUOTE_MIRROR_BASE_URL=
MIRROR_QUOTE_TIMEOUT_MS=15000
# Mirror contract-call envelope, aligned with SaucerSwap's production server call shape.
MIRROR_QUOTE_GAS=10000000
MIRROR_QUOTE_GAS_PRICE_TINYBAR=100000000
MIRROR_QUOTE_429_MAX_ATTEMPTS=2
MIRROR_QUOTE_429_BASE_BACKOFF_MS=500
MIRROR_QUOTE_429_MAX_BACKOFF_MS=10000
MIRROR_QUOTE_429_JITTER_MS=250

# External mutations are fail-closed. These flags are evidence gates, not a
# substitute for deploying/probing the named surface first.
SAME_WALLET_EXECUTION_ENABLED=0
MAINNET_EXECUTION_ENABLED=0
POLICY_RPC_ENABLED=0
POLICY_RPC_AUTHORIZER_READY=0
ERC20_WRAPPER_LIVE_PROVEN=0

# Server-only bridge/provider routes. Never expose these through VITE_*.
SQUID_INTEGRATOR_ID=
SQUID_MAINNET_API_BASE_URL=https://v2.api.squidrouter.com
# No current testnet URL is assumed; set only after an authoritative probe.
SQUID_TESTNET_API_BASE_URL=
# Credentialed fallback for routes without a route-specific permissionless contract path.
LAYERZERO_TRANSFER_API_URL=https://transfer.layerzero-api.com/v1
LAYERZERO_TRANSFER_API_KEY=
# Public read-only RPCs for verified WBTC/USDT0 direct OFTs and native ETH Stargate V2 taxi.
LAYERZERO_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
LAYERZERO_HEDERA_RPC_URL=https://mainnet.hashio.io/api
LAYERZERO_SCAN_API_URL=https://scan.layerzero-api.com/v1
SAUCERSWAP_API_BASE_URL=https://api.saucerswap.finance
SAUCERSWAP_TESTNET_API_BASE_URL=https://test-api.saucerswap.finance
# Refuel runtime key contract. On this host the no-output loader maps the general
# SAUCERSWAP_PUBLIC_API_KEY secret to this name; never copy the value into source.
SAUCERSWAP_API_KEY=
# Deployed read-only EVM account used only as the QuoterV2 eth_call caller so
# hollow/new destination users can receive quotes before activation.
SAUCERSWAP_QUOTE_CALLER=
SAUCERSWAP_API_DISABLED_REASON=SAUCERSWAP_DEVELOPER_API_NOT_CONFIGURED
# Graph cache contains the complete token + V1/V2 pool snapshot (1s..300s).
SAUCERSWAP_GRAPH_CACHE_MS=30000
# Derived route cache: 1s..60s. Quote cache: 0s..30s, never beyond quote expiry.
SAUCERSWAP_ROUTE_CACHE_MS=15000
SAUCERSWAP_QUOTE_CACHE_MS=5000
SAUCERSWAP_CACHE_MAX_ENTRIES=64
MAX_SAUCER_HOPS=3
MAX_SAUCER_QUOTE_CANDIDATES=8
# Exact simulations are always concurrency=1; spacing must be 50ms..5000ms.
SAUCERSWAP_QUOTE_SPACING_MS=500
# Execution quote maximum age: 1s..60s; graph freshness never extends it. Human
# pacing routinely outlives this, so every sponsored leg refreshes the
# destination quote and retries rather than executing a stale simulation.
SAUCERSWAP_QUOTE_MAX_AGE_MS=15000
# Thinnest-hop floor for the selected refuel route, as a dead-pool filter only.
# The refuel swap is capped at MAX_REFUEL_TINYBAR (50 HBAR, ~$3.31). 150 bps of
# price impact at that size needs ~$450 of balanced-pool TVL, so below that
# MAX_PRICE_IMPACT_BPS — not this floor — is what rejects a fill, per amount
# rather than per asset. Raise it if you want refuel restricted to deep pools;
# the per-quote gates (exact-output simulation, MAX_PRICE_IMPACT_BPS, fair
# value, max slippage) are what actually bound a bad fill.
MIN_SAUCER_ROUTE_LIQUIDITY_USD=100
# Keep 0 unless an operator has reviewed the exact alternate provider host.
ALLOW_CUSTOM_PROVIDER_HOSTS=0

# Standard EVM x402 exact/Permit2 path for eip155:296 / eip155:295.
# These are server-only. Readiness still probes bytecode and facilitator support.
# Leave these unset (commented) so contracts/deployments.json — the tracked
# deployment authority — supplies the addresses. Setting any of them overrides
# the registry and is for emergencies only. Mainnet Permit2 is intentionally NOT
# at the canonical address; never assume 0x...78BA3 on chain 295.
# PERMIT2_TESTNET_ADDRESS=
# PERMIT2_MAINNET_ADDRESS=
# X402_PROXY_TESTNET_ADDRESS=
# X402_PROXY_MAINNET_ADDRESS=
X402_PAYMENT_RECIPIENT=
X402_EVM_FACILITATOR_URL=
# Self-hosted facilitator process. Do not enable or fund under source-only GO.
FACILITATOR_CHAIN_ID=296
FACILITATOR_RPC_URL=https://testnet.hashio.io/api
FACILITATOR_PROXY_ADDRESS=
# TESTNET/local value (canonical Permit2). No deployments.json fallback here:
# mainnet facilitators MUST set 0x71304d9943C9d46A18cB6238759800320540F0e4
# per contracts/deployments.json.
FACILITATOR_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
FACILITATOR_PRIVATE_KEY=
FACILITATOR_EXPECTED_ADDRESS=
FACILITATOR_EXECUTION_ENABLED=0
FACILITATOR_HOST=0.0.0.0
FACILITATOR_PORT=4402
FACILITATOR_RATE_LIMIT_PER_MINUTE=60
FACILITATOR_SETTLEMENT_GAS_LIMIT=750000
PRODUCT_PAYMENT_VERIFIER_ENABLED=0
PRODUCT_INTENT_BUILDER_ENABLED=0
PRODUCT_RECEIPT_RECONCILER_ENABLED=0
# Legacy non-browser/native-Hedera technical API only; not the core product.
FACILITATOR_URL=https://api.testnet.blocky402.com

# HAPI sponsor behind the policy RPC. The browser never receives these.
SPONSOR_PRIVATE_KEY=0x...
SPONSOR_EVM_ADDRESS=0x...
SPONSOR_ACCOUNT_ID=0.0.x

# PostgreSQL is the production lifecycle and authorization authority.
DATABASE_URL=postgresql://user:password@host:5432/refuel402
DATABASE_POOL_MAX=5
PRODUCT_LIFECYCLE_RATE_LIMIT_MAX=60
# Poll only already-durable bridge_pending journeys. PostgreSQL advisory locks
# provide one owner per journey across instances; no wallet/sponsor action occurs.
PRODUCT_BRIDGE_SWEEPER_ENABLED=1
PRODUCT_BRIDGE_SWEEPER_INTERVAL_MS=15000
PRODUCT_BRIDGE_SWEEPER_MIN_BACKOFF_MS=5000
PRODUCT_BRIDGE_SWEEPER_MAX_BACKOFF_MS=20000
PRODUCT_BRIDGE_SWEEPER_CONCURRENCY=2
# Local/test-only fallback.
DATA_DIR=./data

# Upstream reads. MetaMask points at /rpc/<mode>, not these private values.
RPC_URL=https://testnet.hashio.io/api
MAINNET_RPC_URL=https://mainnet.hashio.io/api
FRONTEND_ORIGINS=https://refuel402.pages.dev
TRUST_PROXY_HOPS=1
# Railway is auto-detected. Set only for a reviewed non-Railway proxy that overwrites X-Real-IP.
TRUST_REAL_IP_HEADER=0
RATE_LIMIT_SALT=replace-in-hosting-secrets

# Product quote and route controls.
BRIDGE_QUOTE_TTL_SEC=300
QUOTE_TTL_SEC=60
MIN_RETAINED_TOKEN_BPS=500
MAX_SLIPPAGE_BPS=300
MAX_PRICE_IMPACT_BPS=150
# Maximum allowed gap between the quote-implied token/HBAR rate and independent
# price evidence (SaucerSwap graph priceUsd + HBAR/USD). Catches stale-pool
# mispricing that same-pool price impact cannot see. Skipped, never fabricated,
# when price evidence is unavailable.
MAX_QUOTE_FAIR_VALUE_DEVIATION_BPS=300
# Browser default remains editable; every quote sends an explicit desired HBAR value.
RECOMMENDED_REFUEL_TINYBAR=1000000000
# Absolute server policy cap (50 HBAR); affordability may produce a lower maximum.
MAX_REFUEL_TINYBAR=5000000000
# Desired quote + at most seven additional selected-route exact-output candidates.
MAX_HBAR_SOLVER_CANDIDATES=8

# Sponsor exposure and pricing controls.
MAX_GAS_LIMIT=2000000
PRODUCT_INTENT_GAS_LIMIT_MAX=2000000
# Sponsored authorization lifetime. Below a fixed 30s runway the intent returns
# 409 QUOTE_EXPIRES_TOO_SOON so the client re-quotes; never widen it to paper
# over a stale destination simulation.
PRODUCT_AUTHORIZATION_TTL_SEC=180
MIN_DEADLINE_BUFFER_SEC=240
MAX_DEADLINE_SKEW_SEC=900
FEE_MARGIN=1.25
FEE_FLAT_USD=0.005
ALLOWANCE_HEADROOM=1.5
FEE_FLOOR_TINYBAR=20000000
PER_TX_ALLOWANCE_CAP_TINYBAR=1000000000
HAPI_RESERVE_PER_LEG_TINYBAR=20000000
# Serious-testing envelope: at most 15 HBAR per request, 75 HBAR/day, and a 150 HBAR reserve floor.
PER_REQUEST_EXPOSURE_CAP_TINYBAR=1500000000
SPONSOR_MIN_RESERVE_TINYBAR=15000000000
DAILY_SPONSOR_CAP_TINYBAR=7500000000
DESTINATION_ACTIVATION_TINYBAR=10000000
DESTINATION_ACTIVATION_MAX_TINYBAR=50000000

# Existing technical/demo paths. Not part of the stock-MetaMask acceptance.
DEMO_USER_PRIVATE_KEY=0x...
DEMO_USER_EVM_ADDRESS=0x...
DEMO_ENABLE=0
DEMO_AUTH_TOKEN=replace-with-at-least-16-random-characters
ALLOW_HOLLOW_EXPERIMENT=0
LIVE_AGENT_KIT=0
REFUEL_URL=
DEMO_USER_ACCOUNT_ID=
AGENT_FUEL_TOKEN_ID=0.0.5449
AGENT_DESIRED_HBAR=0.5

# Public frontend values only.
VITE_STATIC_READ_ONLY=0
VITE_API_BASE_URL=
