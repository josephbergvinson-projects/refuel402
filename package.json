{
  "name": "refuel402",
  "version": "0.1.0",
  "private": true,
  "description": "Refuel402 — one-MetaMask bridge-to-Hedera and x402-paid HBAR refuel flow.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "server": "tsx server/src/index.ts",
    "facilitator:self-host": "tsx scripts/run-local-evm-facilitator.ts",
    "runtime:verify": "tsx scripts/verify-runtime-package.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck && npm run contracts:compile && npm run contracts:verify && npm run contracts:evm-test && npm run e2e:harness && npm run e2e:product-harness && npm run e2e:browser-harness && npm run build:web",
    "e2e": "tsx scripts/run-e2e.ts",
    "e2e:harness": "tsx scripts/run-e2e-harness.ts",
    "e2e:product-harness": "tsx scripts/run-product-e2e-harness.ts",
    "e2e:browser-harness": "tsx scripts/run-browser-ui-harness.ts",
    "contracts:compile": "tsx scripts/compile-contract.ts",
    "contracts:verify": "tsx scripts/verify-contract-artifacts.ts && tsx scripts/verify-permit2-artifact.ts --source-only",
    "contracts:evm-test": "tsx scripts/run-contract-evm-tests.ts",
    "proof:permit2-reference": "tsx scripts/verify-permit2-artifact.ts",
    "permit2:plan": "tsx scripts/deploy-permit2-create2.ts",
    "permit2:deploy": "tsx scripts/deploy-permit2-create2.ts --execute",
    "proxy:plan": "tsx scripts/deploy-proxy-create2.ts",
    "proxy:deploy": "tsx scripts/deploy-proxy-create2.ts --execute",
    "contracts:verify:source": "tsx scripts/verify-contract-artifacts.ts --source-only",
    "agent:tool": "tsx scripts/run-agent-kit-tool.ts",
    "diagnostic:sponsor-primitive": "tsx scripts/prove-sponsorship.ts",
    "proof:saucer-api": "tsx scripts/probe-saucer-api.ts",
    "proof:saucer-credential": "tsx scripts/probe-saucer-credential.ts",
    "proof:saucer-route": "tsx scripts/probe-saucer-route.ts",
    "proof:squid-route": "tsx scripts/probe-squid-mainnet.ts",
    "proof:layerzero-route": "tsx scripts/probe-layerzero-bridge.ts",
    "proof:economic-matrix": "tsx scripts/probe-production-economic-matrix.ts",
    "proof:provider-matrix": "tsx scripts/probe-production-provider-matrix.ts",
    "proof:product-quote-model": "tsx scripts/probe-product-quote-model.ts",
    "proof:chain-state": "tsx scripts/probe-chain-state.ts",
    "proof:postgres-schema": "tsx scripts/probe-postgres-schema.ts",
    "build:web": "vite build && tsx scripts/write-web-headers.ts",
    "build:pages": "tsx scripts/build-pages-release.ts",
    "dev:web": "vite"
  },
  "dependencies": {
    "@hashgraph/hedera-agent-kit": "4.0.0",
    "@hiero-ledger/sdk": "^2.85.0",
    "@x402/core": "^2.19.0",
    "@x402/evm": "^2.19.0",
    "@x402/hedera": "^2.19.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "8.16.3",
    "protobufjs": "8.0.1",
    "tsx": "^4.19.2",
    "viem": "^2.33.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "^1.7.1",
    "@preact/signals": "^2.10.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5",
    "preact": "^10.29.7",
    "typescript": "^5.7.2",
    "vite": "8.1.5",
    "vitest": "^2.1.8"
  }
}
